# =============================================================================
# Unity .gitignore
# Based on https://github.com/github/gitignore/blob/main/Unity.gitignore (CC0-1.0)
# Place at the Unity project root.
# =============================================================================

# -----------------------------------------------------------------------------
# Unity generated folders (always regenerated)
# -----------------------------------------------------------------------------
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
.utmp/

# Builds
/[Bb]uild/
/[Bb]uilds/
*.apk
*.aab
*.app
*.unitypackage
*.unitypackage.meta

# Large / potentially sensitive captures
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Crash / diagnostics
sysinfo.txt
mono_crash.*
crashlytics-build.properties
*.log

# -----------------------------------------------------------------------------
# IDE / editor generated files
# (The .vsconfig file is intentionally NOT ignored; it should be shared.)
# -----------------------------------------------------------------------------
# Visual Studio
.vs/
*.csproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.VC.db
*.opendb
*.pidb
*.pidb.meta
*.booproj
*.svd
*.unityproj

# JetBrains Rider
.idea/
*.DotSettings.user
/[Aa]ssets/Plugins/Editor/JetBrains*

# VS Code
.vscode/

# MonoDevelop / Consulo
ExportedObj/
.consulo/

# Debug symbols
*.pdb
*.pdb.meta
*.mdb
*.mdb.meta

# Gradle
.gradle/

# Scene dependency cache
/[Aa]ssets/[Ss]ceneDependencyCache*

# Visual Scripting
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# Addressables
/ServerData
/[Aa]ssets/StreamingAssets/aa*
/[Aa]ssets/StreamingAssets/aa.meta
/[Aa]ssets/StreamingAssets/aa/*
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/Addressables_Temp*
/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Blender backup files
*.blend1
*.blend1.meta

# -----------------------------------------------------------------------------
# OS / temp files
# -----------------------------------------------------------------------------
.DS_Store
._*
Thumbs.db
ehthumbs.db
Desktop.ini
*.tmp
*.swp
*~
*.orig

# Claude Code local settings
.claude/settings.local.json

# -----------------------------------------------------------------------------
# Project-specific (ACT)
# Removed prototype scripts / scenes that should stay out of the repo
# -----------------------------------------------------------------------------
/Assets/Scripts/CustomVerticalScrollView.cs
/Assets/Scripts/CustomVerticalScrollView.cs.meta
/Assets/Scripts/Item.cs
/Assets/Scripts/Item.cs.meta
/Assets/Scenes/ScrollView.unity
/Assets/Scenes/ScrollView.unity.meta
