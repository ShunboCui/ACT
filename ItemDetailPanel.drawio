        <UserObject label="&lt;pre style=&quot;font-family: 新宋体; font-size: 9pt;&quot;&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;font&gt;    &lt;/font&gt;OnPointerClick&lt;font&gt;:&lt;/font&gt;&lt;font&gt;&lt;br&gt;        &lt;/font&gt;if&lt;font&gt; &lt;/font&gt;(&lt;font&gt;selectedCount &amp;gt;= totalCount&lt;/font&gt;)&lt;font&gt; &lt;/font&gt;&lt;font&gt;do nothing&lt;/font&gt;&lt;font&gt;&lt;br&gt;        selectedCount += 1;&lt;br&gt;        Add 1 to ItemDetailPanel material count pair, based on uid;&lt;/font&gt;&lt;font&gt;&lt;br&gt;        Add Exp to ItemDetailPanel;&lt;br&gt;        &lt;/font&gt;Refresh display Number&lt;font&gt;;&lt;br&gt;    &lt;/font&gt;&lt;/span&gt;&lt;/pre&gt;" link="&lt;pre style=&quot;font-family:新宋体;font-size:9pt;color:#000000&quot;&gt;    &lt;span style=&quot;color:#0000ff&quot;&gt;public&lt;/span&gt; &lt;span style=&quot;color:#0000ff&quot;&gt;void&lt;/span&gt; &lt;span style=&quot;color:#74531f&quot;&gt;OnPointerClick&lt;/span&gt;&lt;span style=&quot;color:#ffd702&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color:#2b91af&quot;&gt;PointerEventData&lt;/span&gt; &lt;span style=&quot;color:#1f377f&quot;&gt;eventData&lt;/span&gt;&lt;span style=&quot;color:#ffd702&quot;&gt;)&lt;/span&gt;&#xa;    &lt;span style=&quot;color:#ffd702&quot;&gt;{&lt;/span&gt;&#xa;        &lt;span style=&quot;color:#8f08c4&quot;&gt;if&lt;/span&gt; &lt;span style=&quot;color:#d86ac2&quot;&gt;(&lt;/span&gt;selectedCount &amp;gt;= totalCount&lt;span style=&quot;color:#d86ac2&quot;&gt;)&lt;/span&gt; &lt;span style=&quot;color:#8f08c4&quot;&gt;return&lt;/span&gt;;&#xa;        selectedCount += 1;&#xa;        uiParent.&lt;span style=&quot;color:#74531f&quot;&gt;AddMaterialUidCount&lt;/span&gt;&lt;span style=&quot;color:#d86ac2&quot;&gt;(&lt;/span&gt;inventoryMaterialItem.uid&lt;span style=&quot;color:#d86ac2&quot;&gt;)&lt;/span&gt;;&#xa;        uiParent.totalExpGain += packageTableItem.expGain;&#xa;        &lt;span style=&quot;color:#74531f&quot;&gt;RefreshNumber&lt;/span&gt;&lt;span style=&quot;color:#d86ac2&quot;&gt;()&lt;/span&gt;;&#xa;    &lt;span style=&quot;color:#ffd702&quot;&gt;}&lt;/span&gt;&lt;/pre&gt;" id="XaGGuLg5vc8r4vhpNRoa-19">
